---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Prémiová doména pokemongo.sk je na predaj. Ideálna adresa pre slovenský e-shop s Pokémon kartičkami, komunitný portál alebo sprievodcu hrou.",
  image = "/favicon.svg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://pokemongo.sk");
---

<!doctype html>
<html lang="sk" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:site_name" content="Pokemongo.sk" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-display {
        font-family: 'Space Grotesk', system-ui, sans-serif;
      }
      .glow-red {
        box-shadow: 0 0 50px -10px rgba(238, 21, 21, 0.25);
      }
      .glow-yellow {
        box-shadow: 0 0 50px -10px rgba(255, 203, 5, 0.25);
      }
      .glow-blue {
        box-shadow: 0 0 50px -10px rgba(42, 117, 187, 0.25);
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-poke-red selection:text-white relative overflow-x-hidden">
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-poke-red/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -left-40 w-[600px] h-[600px] bg-poke-blue/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-0 w-[500px] h-[500px] bg-poke-yellow/10 rounded-full blur-3xl"></div>
      <!-- Subtle Grid Pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b12_1px,transparent_1px),linear-gradient(to_bottom,#1e293b12_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot name="navbar" />
      <main class="flex-grow">
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </body>
</html>
