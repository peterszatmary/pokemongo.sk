---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="pokemongo.sk - Prémiová slovenská doména na predaj"
  description="Exkluzívna národná doména pokemongo.sk je na predaj. Ideálna adresa pre slovenský e-shop s kartičkami, komunitný portál alebo sprievodcu hrou. Pošlite svoju ponuku."
>
  <Navbar slot="navbar" />

  <!-- HERO SECTION -->
  <section class="relative pt-12 pb-20 sm:pt-16 sm:pb-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Column: Copy & CTAs -->
        <div class="lg:col-span-7 space-y-6 text-left">
          
          <!-- Status Pill -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
            PRÉMIOVÁ NÁRODNÁ .SK DOMÉNA NA PREDAJ
          </div>

          <!-- Main Heading -->
          <h1 class="font-display text-4xl sm:text-6xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1]">
            Chyťte prémiovú doménu <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-amber-500 to-rose-500">
              pokemongo.sk
            </span>
          </h1>

          <!-- Subheading -->
          <p class="text-lg sm:text-xl text-slate-600 font-normal leading-relaxed max-w-2xl">
            Vlajková loď pre váš slovenský <strong class="text-slate-900 font-semibold">e-shop s kartičkami</strong>, 
            najväčšiu komunitnú platformu alebo sprievodcu hrou. Žiadne pomlčky, okamžitá dôvera a bezkonkurenčná autorita.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a
              href="#ponuka"
              class="px-8 py-4 rounded-2xl font-bold text-base text-white bg-slate-900 hover:bg-slate-800 hover:-translate-y-0.5 active:translate-y-0 shadow-lg shadow-slate-900/15 transition-all text-center flex items-center justify-center gap-3"
            >
              <img src="/favicon.svg" alt="" class="w-5 h-5" />
              <span>Predložiť cenovú ponuku</span>
            </a>
            <a
              href="#potencial"
              class="px-8 py-4 rounded-2xl font-semibold text-base text-slate-700 bg-white hover:bg-slate-50 border border-slate-200/90 hover:text-slate-900 shadow-sm transition-all text-center"
            >
              Prečo kúpiť túto doménu?
            </a>
          </div>

          <!-- Trust Highlights -->
          <div class="pt-6 border-t border-slate-200/70 grid grid-cols-3 gap-4">
            <div>
              <div class="text-xs uppercase font-bold text-slate-400 tracking-wider">Register</div>
              <div class="text-sm font-semibold text-slate-900 mt-0.5 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                SK-NIC Overené
              </div>
            </div>
            <div>
              <div class="text-xs uppercase font-bold text-slate-400 tracking-wider">Rýchlosť</div>
              <div class="text-sm font-semibold text-slate-900 mt-0.5 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                Prevod do 24 hodín
              </div>
            </div>
            <div>
              <div class="text-xs uppercase font-bold text-slate-400 tracking-wider">Právna istota</div>
              <div class="text-sm font-semibold text-slate-900 mt-0.5 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                Zmluva & Faktúra
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column: Visual Showcase with Charizard & Bulbasaur -->
        <div class="lg:col-span-5 relative flex items-center justify-center">
          
          <!-- Soft Background Aura for Pokémon -->
          <div class="absolute w-80 h-80 sm:w-96 sm:h-96 bg-gradient-to-br from-amber-300/40 via-rose-300/30 to-sky-200/20 rounded-full blur-2xl pointer-events-none"></div>

          <!-- Main Charizard Card / Illustration -->
          <div class="relative w-full max-w-md sm:max-w-lg flex flex-col items-center">
            
            <!-- Large Charizard Image -->
            <div class="relative z-10 w-72 sm:w-96 transition-transform duration-700 animate-float">
              <img
                src="/images/charizard.png"
                alt="Charizard - Pokémon #006"
                class="w-full h-auto drop-shadow-[0_25px_35px_rgba(238,80,30,0.25)] select-none"
              />
              <!-- Floating Charizard Badge -->
              <div class="absolute -top-2 right-2 sm:right-6 bg-white/95 backdrop-blur border border-amber-200 shadow-md px-3 py-1.5 rounded-full flex items-center gap-1.5 text-xs font-bold text-slate-800">
                <span>🔥</span>
                <span>Charizard #006</span>
              </div>
            </div>

            <!-- Bulbasaur Sitting Next to Charizard -->
            <div class="absolute -bottom-6 -left-2 sm:-left-6 z-20 w-36 sm:w-44 transition-transform duration-700 animate-float-delayed">
              <img
                src="/images/bulbasaur.png"
                alt="Bulbasaur - Pokémon #001"
                class="w-full h-auto drop-shadow-[0_15px_25px_rgba(16,185,129,0.25)] select-none"
              />
              <!-- Floating Bulbasaur Badge -->
              <div class="absolute -bottom-2 left-2 bg-white/95 backdrop-blur border border-emerald-200 shadow-md px-3 py-1 rounded-full flex items-center gap-1.5 text-[11px] font-bold text-slate-800">
                <span>🍃</span>
                <span>Bulbasaur #001</span>
              </div>
            </div>

            <!-- Floating SEO Pill -->
            <div class="absolute top-1/2 -right-4 sm:-right-8 z-20 bg-white/95 backdrop-blur border border-slate-200 shadow-lg px-3.5 py-2 rounded-2xl flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <div class="text-left">
                <div class="text-[10px] uppercase font-bold text-slate-400">Organické SEO</div>
                <div class="text-xs font-bold text-slate-900">#1 Pokémon na Slovensku</div>
              </div>
            </div>

          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- VALUE / ADVANTAGES SECTION -->
  <section id="potencial" class="py-20 bg-white border-y border-slate-200/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest font-bold text-rose-600 bg-rose-50 px-3 py-1 rounded-full border border-rose-200">
          Hodnota & Potenciál
        </span>
        <h2 class="font-display text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight mt-4">
          Názov, ktorý pozná každý fanúšik na Slovensku
        </h2>
        <p class="text-slate-600 text-base sm:text-lg mt-4 leading-relaxed">
          Čistá adresa s národnou koncovkou .sk vám dáva okamžitú konkurenčnú výhodu, ktorú si nemožno kúpiť v žiadnej reklamnej kampani.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Feature 1 -->
        <div class="p-8 rounded-3xl bg-slate-50/70 border border-slate-200/80 hover:border-amber-300 hover:bg-white hover:shadow-xl hover:shadow-amber-500/5 transition-all">
          <div class="w-12 h-12 rounded-2xl bg-amber-100/70 border border-amber-200 flex items-center justify-center text-amber-700 font-bold mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-slate-900 mb-3">Zberateľský boom s kartami</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Pokémon TCG kartičky, boostre a zberateľské boxy zažívajú rekordný rast. Zákazníci hľadajú overené slovenské obchody a silná doména buduje dôveru pri platbe okamžite.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-8 rounded-3xl bg-slate-50/70 border border-slate-200/80 hover:border-rose-300 hover:bg-white hover:shadow-xl hover:shadow-rose-500/5 transition-all">
          <div class="w-12 h-12 rounded-2xl bg-rose-100/70 border border-rose-200 flex items-center justify-center text-rose-600 font-bold mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-slate-900 mb-3">Priamy organický traffic</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Tisíce ľudí denne zadávajú kľúčové slovo priamo do prehliadača alebo vyhľadávača. S touto doménou získavate bezkonkurenčnú SEO výhodu oproti generic názvom.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-8 rounded-3xl bg-slate-50/70 border border-slate-200/80 hover:border-sky-300 hover:bg-white hover:shadow-xl hover:shadow-sky-500/5 transition-all">
          <div class="w-12 h-12 rounded-2xl bg-sky-100/70 border border-sky-200 flex items-center justify-center text-sky-700 font-bold mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-slate-900 mb-3">Maximálna autorita brandu</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Kratší, údernejší a reprezentatívnejší názov v rámci slovenskej .sk zóny už neexistuje. Žiadne pomlčky, žiadne skratky — čistý a ľahko zapamätateľný brand.
          </p>
        </div>

      </div>

      <!-- Spotlight Banner with Bulbasaur -->
      <div class="mt-12 p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-emerald-50 via-teal-50 to-slate-50 border border-emerald-200/80 flex flex-col sm:flex-row items-center gap-8 shadow-sm">
        <div class="w-28 sm:w-36 shrink-0">
          <img src="/images/bulbasaur.png" alt="Bulbasaur" class="w-full h-auto drop-shadow-md select-none" />
        </div>
        <div class="flex-grow space-y-2 text-center sm:text-left">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100/80 px-2.5 py-1 rounded-full">
            Prvý krok ku skvelému projektu (#001)
          </span>
          <h3 class="font-display text-2xl font-bold text-slate-900">
            Ako Bulbasaur na začiatku cesty trénera
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed max-w-2xl">
            Každá úspešná online značka potrebuje pevný základ. Správna prémiová doména vám ušetrí tisíce eur na marketingových nákladoch už od prvého dňa.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href="#ponuka"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm text-white bg-slate-900 hover:bg-slate-800 transition shadow-sm"
          >
            Mám záujem →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- USE CASES SECTION -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest font-bold text-amber-700 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
          Obchodné Modely
        </span>
        <h2 class="font-display text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight mt-4">
          Ako môžete túto doménu využiť?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Card 1: E-shop -->
        <div class="bg-white p-8 rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="inline-block px-3 py-1 rounded-lg text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 mb-4">
              Najvýnosnejší model
            </div>
            <h3 class="font-display text-2xl font-bold text-slate-900 mb-3">E-shop s kartami & Merchom</h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Predávajte Pokémon TCG Booster boxy, Elite Trainer Boxy, obaly, albumy a jednotlivé karty. Doména buduje okamžitú autoritu u rodičov aj zberateľov.
            </p>
          </div>
          <a href="/tcg-karty" class="inline-flex items-center gap-2 text-sm font-semibold text-rose-600 hover:underline">
            Prečítať viac o TCG trhu →
          </a>
        </div>

        <!-- Card 2: Community -->
        <div class="bg-white p-8 rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="inline-block px-3 py-1 rounded-lg text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200 mb-4">
              Komunitný projekt
            </div>
            <h3 class="font-display text-2xl font-bold text-slate-900 mb-3">Portál, Raid Hub & Turnaje</h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Vytvorte centrálu pre slovenských trénerov: koordinácia raidov, kalendár Community Days, tímové rebríčky a registrácia na lokálne zberateľské burzy.
            </p>
          </div>
          <a href="/komunita" class="inline-flex items-center gap-2 text-sm font-semibold text-sky-700 hover:underline">
            Prehľad slovenskej komunity →
          </a>
        </div>

        <!-- Card 3: Magazine / Info -->
        <div class="bg-white p-8 rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="inline-block px-3 py-1 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-4">
              Informačný portál & SEO
            </div>
            <h3 class="font-display text-2xl font-bold text-slate-900 mb-3">Sprievodca a herný magazín</h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Kompletné návody, IV kalkulačky, tier listy útočníkov a novinky z herného sveta. Monetizácia cez Google AdSense, affiliate partnerstvá a sponzorovaný obsah.
            </p>
          </div>
          <a href="/sprievodca" class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:underline">
            Ukážka sprievodcu hrou →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- OFFER FORM SECTION -->
  <section id="ponuka" class="py-20 bg-slate-50/80 border-t border-slate-200/80 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm />
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-20 bg-white border-t border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs uppercase tracking-widest font-bold text-slate-400">Časté otázky</span>
        <h2 class="font-display text-3xl font-bold text-slate-900 mt-2">Všetko, čo potrebujete vedieť o kúpe</h2>
      </div>

      <div class="space-y-4">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/70">
          <h3 class="text-base font-bold text-slate-900 mb-2">Ako prebieha prevod domény?</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Prevod prebieha podľa štandardných pravidiel SK-NIC. Po dohode o cene a úhrade vám vygenerujeme autorizačný kód (Auth-Info kód), pomocou ktorého si doménu okamžite prenesiete k svojmu registrátorovi (Websupport, Forpsi, atď.).
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/70">
          <h3 class="text-base font-bold text-slate-900 mb-2">Je možné vystaviť faktúru alebo kúpnu zmluvu?</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Áno, samozrejmosťou je vystavenie oficiálnej kúpno-predajnej zmluvy a riadnej faktúry pre právnické aj fyzické osoby. Pre maximálnu bezpečnosť je možné využiť aj notársku či advokátsku úschovu.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/70">
          <h3 class="text-base font-bold text-slate-900 mb-2">Ako dlho celý proces trvá?</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Akonáhle sa dohodneme a prebehne platba, prevod v systéme SK-NIC trvá zvyčajne menej ako 1 hodinu (maximálne 24 hodín). Doména je následne plne vo vašom vlastníctve.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
