---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="pokemongo.sk - Prémiová slovenská doména na predaj"
  description="Exkluzívna národná doména pokemongo.sk je na predaj. Ideálna pre slovenský e-shop s kartičkami, komunitný portál alebo sprievodcu hrou. Pošlite svoju ponuku."
>
  <Navbar slot="navbar" />

  <!-- HERO SECTION -->
  <section class="relative pt-12 pb-20 sm:pt-20 sm:pb-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto space-y-6">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs sm:text-sm font-semibold bg-poke-red/10 text-poke-red border border-poke-red/30 shadow-lg shadow-poke-red/10 animate-bounce">
          <span class="w-2.5 h-2.5 rounded-full bg-poke-red"></span>
          PRÉMIOVÁ NÁRODNÁ DOMÉNA JE VOĽNÁ NA PREDAJ
        </div>

        <!-- Main Heading -->
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-tight">
          Chyťte prémiovú doménu <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-poke-yellow via-amber-300 to-poke-red">
            pokemongo.sk
          </span>
        </h1>

        <!-- Subheading -->
        <p class="text-lg sm:text-2xl text-slate-300 font-normal leading-relaxed max-w-3xl mx-auto">
          Získajte najsilnejšiu adresu pre váš slovenský <span class="text-poke-yellow font-semibold">e-shop s kartičkami</span>, 
          hernú komunitu alebo špecializovaný magazín. Žiadne pomlčky, maximálna autorita.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <a
            href="#ponuka"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl font-bold text-base text-slate-950 bg-gradient-to-r from-poke-yellow via-amber-400 to-poke-yellow hover:scale-105 active:scale-95 shadow-xl shadow-amber-500/25 transition-all text-center flex items-center justify-center gap-3"
          >
            <img src="/favicon.svg" alt="" class="w-5 h-5" />
            <span>Predložiť cenovú ponuku</span>
          </a>
          <a
            href="#potencial"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl font-semibold text-base text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 hover:text-white transition-all text-center"
          >
            Prečo kúpiť túto doménu?
          </a>
        </div>

        <!-- Metrics / Highlights Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-12 max-w-4xl mx-auto">
          <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 backdrop-blur">
            <div class="text-2xl sm:text-3xl font-display font-bold text-poke-yellow">.sk</div>
            <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-medium">Národná koncovka</div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 backdrop-blur">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white">100%</div>
            <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-medium">Brand Awareness</div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 backdrop-blur">
            <div class="text-2xl sm:text-3xl font-display font-bold text-emerald-400">&lt; 24h</div>
            <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-medium">Rýchly prevod</div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 backdrop-blur">
            <div class="text-2xl sm:text-3xl font-display font-bold text-poke-blue">SK-NIC</div>
            <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-medium">Oficiálny register</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- VALUE / ADVANTAGES SECTION -->
  <section id="potencial" class="py-20 bg-slate-950/60 border-y border-slate-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs uppercase tracking-widest font-bold text-poke-yellow mb-3">Prečo investovať do pokemongo.sk</h2>
        <p class="font-display text-3xl sm:text-5xl font-bold text-white tracking-tight">
          Názov, ktorý pozná každý fanúšik na Slovensku
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-poke-yellow/40 transition-all hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-poke-yellow mb-6">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-white mb-3">Masívny zberateľský boom</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Pokémon TCG kartičky, boostre a zberateľské boxy zažívajú na Slovensku nebývalý rast. Zákazníci hľadajú overené slovenské obchody a silná doména buduje dôveru okamžite.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-poke-red/40 transition-all hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-poke-red mb-6">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-white mb-3">Priamy organický traffic</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Tisíce ľudí denne zadávajú kľúčové slovo priamo do prehliadača alebo vyhľadávača. S touto doménou získavate bezkonkurenčnú SEO výhodu oproti generic názvom.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-poke-blue/40 transition-all hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-poke-blue mb-6">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-white mb-3">Maximálna dôveryhodnosť</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Kratší, údernejší a reprezentatívnejší názov v rámci slovenskej .sk zóny už neexistuje. Žiadne pomlčky, žiadne skratky — čistý a ľahko zapamätateľný brand.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- USE CASES SECTION -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs uppercase tracking-widest font-bold text-poke-red mb-3">Možnosti monetizácie</h2>
        <p class="font-display text-3xl sm:text-5xl font-bold text-white tracking-tight">
          Ako môžete túto doménu využiť?
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="relative bg-gradient-to-b from-slate-900 to-slate-950 p-8 rounded-3xl border border-slate-800 flex flex-col justify-between">
          <div>
            <div class="inline-block px-3 py-1 rounded-lg text-xs font-semibold bg-poke-yellow/10 text-poke-yellow border border-poke-yellow/20 mb-4">
              Najvýnosnejší model
            </div>
            <h3 class="font-display text-2xl font-bold text-white mb-3">E-shop s kartami & Merchom</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              Predávajte Pokémon TCG Booster boxy, Elite Trainer Boxy, obaly, albumy a jednotlivé karty. Doména buduje okamžitú autoritu u rodičov aj zberateľov.
            </p>
          </div>
          <a href="/tcg-karty" class="inline-flex items-center gap-2 text-sm font-semibold text-poke-yellow hover:underline">
            Prečítať viac o TCG trhu →
          </a>
        </div>

        <!-- Card 2 -->
        <div class="relative bg-gradient-to-b from-slate-900 to-slate-950 p-8 rounded-3xl border border-slate-800 flex flex-col justify-between">
          <div>
            <div class="inline-block px-3 py-1 rounded-lg text-xs font-semibold bg-poke-blue/10 text-poke-blue border border-poke-blue/20 mb-4">
              Komunitný projekt
            </div>
            <h3 class="font-display text-2xl font-bold text-white mb-3">Portál, Raid Hub & Turnaje</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              Vytvorte centrálu pre slovenských trénerov: koordinácia raidov, kalendár Community Days, tímové rebríčky a registrácia na lokálne zberateľské burzy.
            </p>
          </div>
          <a href="/komunita" class="inline-flex items-center gap-2 text-sm font-semibold text-poke-blue hover:underline">
            Prehľad slovenskej komunity →
          </a>
        </div>

        <!-- Card 3 -->
        <div class="relative bg-gradient-to-b from-slate-900 to-slate-950 p-8 rounded-3xl border border-slate-800 flex flex-col justify-between">
          <div>
            <div class="inline-block px-3 py-1 rounded-lg text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-4">
              Informačný portál & SEO
            </div>
            <h3 class="font-display text-2xl font-bold text-white mb-3">Sprievodca a herný magazín</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              Kompletné návody, IV kalkulačky, tier listy útočníkov a novinky z herného sveta. Monetizácia cez Google AdSense, affiliate partnerstvá a sponzorovaný obsah.
            </p>
          </div>
          <a href="/sprievodca" class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400 hover:underline">
            Ukážka sprievodcu hrou →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- OFFER FORM SECTION -->
  <section id="ponuka" class="py-24 bg-gradient-to-b from-slate-950 via-slate-900/40 to-slate-950 border-t border-slate-800 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm />
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-20 border-t border-slate-800/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-xs uppercase tracking-widest font-bold text-poke-yellow mb-2">Časté otázky</h2>
        <p class="font-display text-3xl font-bold text-white">Všetko, čo potrebujete vedieť o kúpe</p>
      </div>

      <div class="space-y-4">
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
          <h3 class="text-base font-bold text-white mb-2">Ako prebieha prevod domény?</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Prevod prebieha podľa štandardných pravidiel SK-NIC. Po dohode o cene a úhrade vám vygenerujeme autorizačný kód (Auth-Info kód), pomocou ktorého si doménu okamžite prenesiete k svojmu registrátorovi (Websupport, Forpsi, atď.).
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
          <h3 class="text-base font-bold text-white mb-2">Je možné vystaviť faktúru alebo kúpnu zmluvu?</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Áno, samozrejmosťou je vystavenie oficiálnej kúpno-predajnej zmluvy a riadnej faktúry pre právnické aj fyzické osoby. Pre maximálnu bezpečnosť je možné využiť aj notársku či advokátsku úschovu.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
          <h3 class="text-base font-bold text-white mb-2">Ako dlho celý proces trvá?</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Akonáhle sa dohodneme a prebehne platba, prevod v systéme SK-NIC trvá zvyčajne menej ako 1 hodinu (maximálne 24 hodín). Doména je následne plne vo vašom vlastníctve.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
