---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Domov",
        "item": "https://pokemongo.sk/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Ako kúpiť doménu",
        "item": "https://pokemongo.sk/ako-kupit/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Ako kúpiť a bezpečne previesť doménu pokemongo.sk",
    "description": "Postup krok za krokom pri kúpe a prevode národnej domény cez SK-NIC.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Predloženie nezáväznej ponuky",
        "text": "Vyplníte krátky formulár s vašou cenovou ponukou a kontaktnými údajmi."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Zmluva a faktúra",
        "text": "Pripravíme oficiálnu Zmluvu o prevode domény a vystavíme riadnu faktúru."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Autorizačný kód (Auth-Info)",
        "text": "Ihneď po prijatí platby vygenerujeme v systéme SK-NIC autorizačný kód."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Okamžitý prevod pod váš účet",
        "text": "Auth-Info kód zadáte u svojho registrátora a doména je plne vaša."
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Ako dlho trvá prevod domény .sk cez SK-NIC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Po úhrade a vygenerovaní autorizačného kódu (Auth-Info kód) trvá samotný prevod v systéme SK-NIC obvykle menej než 1 hodinu, maximálne do 24 hodín."
        }
      },
      {
        "@type": "Question",
        "name": "Je k dispozícii faktúra a oficiálna kúpna zmluva?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Áno, samozrejmosťou je vypracovanie riadnej Zmluvy o prevode domény a vystavenie faktúry s možnosťou platby bankovým prevodom."
        }
      },
      {
        "@type": "Question",
        "name": "Je možné využiť notársku alebo advokátsku úschovu (Escrow)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Áno, pre garantovanú obojstrannú bezpečnosť transakcie je možné využiť advokátsku alebo notársku úschovu finančných prostriedkov."
        }
      }
    ]
  }
];
---

<Layout
  title="Ako kúpiť doménu pokemongo.sk: Proces prevodu a bezpečnosť"
  description="Podrobný a transparentný postup prevodu národnej domény pokemongo.sk cez SK-NIC. Kúpna zmluva, faktúra, možnosti bezpečnej úschovy a okamžitý transfer."
  keywords="ako kupit domenu, sk-nic prevod domeny, predaj pokemongo.sk, kupna zmluva domena, auth-info kod sk-nic"
  jsonLd={structuredData}
>
  <Navbar slot="navbar" />

  <article class="py-16 sm:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mb-14 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-4">
        🛡️ Bezpečný & Transparentný Prevod
      </div>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
        Ako prebieha kúpa a prevod domény
      </h1>
      <p class="text-base sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Celý proces predaja domény pokemongo.sk sa riadi oficiálnymi pravidlami centrálneho správcu národnej domény SK-NIC.
      </p>
    </header>

    <!-- 4 Step Timeline -->
    <div class="space-y-5 mb-16">

      <div class="flex flex-col sm:flex-row gap-5 p-6 sm:p-7 rounded-3xl bg-white border border-slate-200/90 shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-200 text-amber-700 font-display font-bold text-xl flex items-center justify-center shrink-0">
          01
        </div>
        <div>
          <h2 class="font-display text-xl font-bold text-slate-900 mb-2">Predloženie nezáväznej ponuky</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Vyplníte krátky formulár nižšie s vašou cenovou ponukou a kontaktnými údajmi. Do 24 hodín sa vám ozveme s vyjadrením alebo protinávrhom.
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-5 p-6 sm:p-7 rounded-3xl bg-white border border-slate-200/90 shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-sky-50 border border-sky-200 text-sky-700 font-display font-bold text-xl flex items-center justify-center shrink-0">
          02
        </div>
        <div>
          <h2 class="font-display text-xl font-bold text-slate-900 mb-2">Zmluva a faktúra</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Po odsúhlasení podmienok pripravíme oficiálnu <strong>Zmluvu o prevode domény</strong> a vystavíme faktúru (vhodnú do firemného účtovníctva). Pre vyššie sumy je možné využiť aj notársku alebo advokátsku úschovu (Escrow).
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-5 p-6 sm:p-7 rounded-3xl bg-white border border-slate-200/90 shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 font-display font-bold text-xl flex items-center justify-center shrink-0">
          03
        </div>
        <div>
          <h2 class="font-display text-xl font-bold text-slate-900 mb-2">Autorizačný kód (Auth-Info)</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Ihneď po prijatí platby vygenerujeme v systéme SK-NIC jedinečný autorizačný <strong>Auth-Info kód</strong> pre doménu pokemongo.sk a pošleme vám ho.
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-5 p-6 sm:p-7 rounded-3xl bg-white border border-slate-200/90 shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 font-display font-bold text-xl flex items-center justify-center shrink-0">
          04
        </div>
        <div>
          <h2 class="font-display text-xl font-bold text-slate-900 mb-2">Okamžitý prevod pod váš účet</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Auth-Info kód zadáte vo svojom účte u ľubovoľného registrátora (napr. Websupport, Forpsi, Subreg). Prevod prebehne v priebehu niekoľkých minút a doména je 100% vo vašom vlastníctve.
          </p>
        </div>
      </div>

    </div>

    <!-- Security Guarantees -->
    <div class="p-8 sm:p-10 rounded-3xl bg-slate-50 border border-slate-200/90 mb-16">
      <h2 class="font-display text-2xl font-bold text-slate-900 mb-6">Záruky bezpečnosti transakcie</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-slate-700">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Čistá doménová história bez sankcií</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Možnosť osobného stretnutia v SR</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Platná registrácia v SK-NIC</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Rýchla komunikácia e-mailom a telefonicky</span>
        </div>
      </div>
    </div>

    <!-- Contact Form embedded -->
    <div id="ponuka">
      <ContactForm />
    </div>
  </article>

  <Footer slot="footer" />
</Layout>
