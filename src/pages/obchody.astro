---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import storesList from "../data/stores.json";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Domov",
        "item": "https://pokemongo.sk/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Kde kúpiť Pokémon kartičky v SR a ČR",
        "item": "https://pokemongo.sk/obchody/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Overené obchody a herne s Pokémon kartičkami na Slovensku a v ČR",
    "description": "Zoznam špecializovaných predajní, herní a e-shopov so zberateľskými Pokémon TCG kartičkami.",
    "numberOfItems": storesList.length,
    "itemListElement": storesList.map((s, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "item": {
        "@type": "Store",
        "name": s.name,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": s.address,
          "addressLocality": s.city,
          "addressCountry": "SK"
        },
        "url": s.web,
        "description": s.description
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Kde na Slovensku kúpim zaručene originálne Pokémon karty?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Odporúčame nakupovať v overených špecializovaných predajniach a herniach, ako sú iHRYsko, Funtastic, Cloud 9, Veselý drak alebo TCGPark. Tieto obchody odoberajú tovar priamo od oficiálnych distribútorov."
        }
      },
      {
        "@type": "Question",
        "name": "Ako rozoznám falošné Pokémon kartičky (fejky)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Originálne karty majú vysokokvalitný kartón s tmavou strednou vrstvou, ostrú typografiu bez gramatických chýb, presné farby na zadnom logu Pokéballu a špeciálnu textúru pri ultra-vzácnych (Secret Rare / Full Art) kartách. Pozor na extrémne lacné booster boxy z trhovísk a neoverených čínskych e-shopov."
        }
      },
      {
        "@type": "Question",
        "name": "Čo je najlepšie kúpiť pre začínajúceho hráča alebo zberateľa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pre začínajúcich hráčov sú ideálne Battle Decks (vopred pripravené balíčky pripravené na hru). Pre zberateľov a začiatočníkov je skvelou voľbou Elite Trainer Box (ETB), ktorý obsahuje 9 balíčkov, obaly, kocky a promo kartu."
        }
      }
    ]
  }
];
---

<Layout
  title="Kde kúpiť Pokémon kartičky v SR a ČR: Overené predajne a e-shopy | pokemongo.sk"
  description="Veľký prehľad overených kamenných predajní, herní a e-shopov s originálnymi Pokémon TCG kartami na Slovensku a v Českej republike. Adresy, lokality a webové odkazy."
  keywords="kde kupit pokemon karty, overene pokemon obchody sk, ihrisko pokemon, funtastic bratislava, elite trainer box sk, booster balicky pokemon predaj"
  jsonLd={structuredData}
>
  <Navbar slot="navbar" />

  <section class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-4 shadow-sm">
        <span>🏪</span>
        <span>Overené predajne & herne • Slovensko & Česko</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Kde kúpiť Pokémon kartičky
      </h1>
      <p class="text-base sm:text-xl text-slate-600 mt-4 leading-relaxed">
        Prehľad najlepších kamenných predajní, oficiálnych herní a overených e-shopov so 100% originálnymi Pokémon TCG produktmi na Slovensku a v Českej republike.
      </p>
    </header>

    <!-- Controls: Search & Country Tabs -->
    <div class="mb-10 bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
      
      <!-- Country Tabs -->
      <div class="flex flex-wrap gap-2 justify-center" id="country-filters">
        <button
          type="button"
          data-country="ALL"
          class="country-btn px-5 py-2.5 rounded-2xl text-sm font-bold transition-all border bg-slate-900 text-white border-slate-900 shadow-sm"
        >
          🌍 Všetky obchody ({storesList.length})
        </button>
        <button
          type="button"
          data-country="SK"
          class="country-btn px-5 py-2.5 rounded-2xl text-sm font-bold transition-all border bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100 hover:text-slate-900"
        >
          🇸🇰 Slovensko ({storesList.filter(s => s.country === "SK").length})
        </button>
        <button
          type="button"
          data-country="CZ"
          class="country-btn px-5 py-2.5 rounded-2xl text-sm font-bold transition-all border bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100 hover:text-slate-900"
        >
          🇨🇿 Česká republika ({storesList.filter(s => s.country === "CZ").length})
        </button>
      </div>

      <!-- Search Input -->
      <div class="relative max-w-2xl mx-auto">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="store-search"
          placeholder="Hľadať podľa mesta (Bratislava, Praha, Košice...), názvu alebo adresy..."
          class="w-full pl-12 pr-4 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition text-sm sm:text-base"
        />
      </div>

      <!-- Counter -->
      <div class="flex items-center justify-between text-xs sm:text-sm font-semibold text-slate-500 border-t border-slate-100 pt-4">
        <span id="store-counter-text">Zobrazuje sa {storesList.length} z {storesList.length} obchodov</span>
        <button
          type="button"
          id="reset-stores-btn"
          class="text-rose-600 hover:text-rose-700 hover:underline hidden"
        >
          Resetovať filter
        </button>
      </div>

    </div>

    <!-- Stores Grid -->
    <div id="stores-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        storesList.map((store) => {
          const searchData = `${store.name.toLowerCase()} ${store.city.toLowerCase()} ${store.address.toLowerCase()} ${store.countryName.toLowerCase()} ${store.tags.join(" ").toLowerCase()}`;

          return (
            <div
              class="store-card bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-7 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
              data-search={searchData}
              data-country={store.country}
            >
              <div>
                <!-- Header with Flags & Type -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                  <div class="flex items-center gap-2">
                    <span class={`px-2.5 py-1 rounded-xl text-xs font-bold ${
                      store.country === "SK" 
                        ? "bg-blue-50 text-blue-700 border border-blue-200" 
                        : "bg-red-50 text-red-700 border border-red-200"
                    }`}>
                      {store.country === "SK" ? "🇸🇰 Slovensko" : "🇨🇿 Česko"}
                    </span>
                    <span class="text-xs font-semibold text-slate-500">
                      {store.city}
                    </span>
                  </div>

                  <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">
                    {store.type}
                  </span>
                </div>

                <!-- Store Name -->
                <h3 class="font-display text-2xl font-bold text-slate-900 mb-2 flex items-center gap-2">
                  <span>{store.name}</span>
                  <svg class="w-5 h-5 text-sky-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </h3>

                <!-- Address -->
                <div class="flex items-start gap-2 text-xs sm:text-sm text-slate-600 mb-4 bg-slate-50 p-3 rounded-xl border border-slate-200/70">
                  <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>{store.address}</span>
                </div>

                <!-- Description -->
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  {store.description}
                </p>

                <!-- Features Badges -->
                <div class="flex flex-wrap gap-1.5 mb-6">
                  {store.features.map((feat) => (
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-700 bg-slate-100/90 px-2.5 py-1 rounded-lg">
                      <span class="text-emerald-600 font-bold">✓</span>
                      <span>{feat}</span>
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Link -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-400">Overený predajca</span>
                <a
                  href={store.web}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs text-white bg-slate-900 hover:bg-slate-800 transition shadow-sm"
                >
                  <span>Prejsť na web</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>

            </div>
          );
        })
      }
    </div>

    <!-- Empty State -->
    <div id="no-store-results" class="hidden text-center py-16 bg-white border border-slate-200/90 rounded-3xl p-8 mt-6">
      <div class="text-4xl mb-3">📍</div>
      <h3 class="font-display text-xl font-bold text-slate-900 mb-2">Žiaden obchod sa nenašiel</h3>
      <p class="text-sm text-slate-500 max-w-md mx-auto mb-4">
        Skúste vyhľadať iné mesto alebo kliknite na resetovanie filtra.
      </p>
      <button
        type="button"
        id="empty-store-reset-btn"
        class="px-5 py-2.5 rounded-xl font-semibold text-xs text-white bg-slate-900 hover:bg-slate-800 transition"
      >
        Zobraziť všetky predajne
      </button>
    </div>

    <!-- Buyer Guide: How to avoid fake cards -->
    <div class="mt-16 p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/90 shadow-sm space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-700 text-lg font-bold">
          🛡️
        </div>
        <h3 class="font-display text-2xl font-bold text-slate-900">
          Ako spoznať pravé Pokémon karty a vyhnúť sa falzifikátom?
        </h3>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-sm text-slate-600">
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
          <strong class="text-slate-900 block mb-1">1. Špeciálna textúra</strong>
          Vzácne Ultra Rare, Secret Rare a Special Illustration karty majú jemný reliéfny povrch (textúru). Falzifikáty sú väčšinou hladké a lesklé.
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
          <strong class="text-slate-900 block mb-1">2. Farba zadnej strany</strong>
          Zadná strana originálnej karty má sýtu tmavomodrú farbu a detailný Pokéball. Falošné karty bývajú vyblednuté, fialkavé alebo rozmazané.
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
          <strong class="text-slate-900 block mb-1">3. Podozrivo nízka cena</strong>
          Ak niekto na bazári alebo tržnici predáva Booster Box (36 balíčkov) za 20-30 €, ide na 100% o čínsky falzifikát. Nakupujte len u overených predajcov z nášho zoznamu.
        </div>
      </div>
    </div>

    <!-- Domain Sale CTA -->
    <div class="mt-16 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-emerald-50 via-teal-50 to-slate-50 border border-emerald-200/80 text-center space-y-4">
      <h3 class="font-display text-2xl sm:text-3xl font-bold text-slate-900">
        Prevádzkujete vlastný e-shop alebo herňu s kartičkami?
      </h3>
      <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Získajte prémiovú doménu <strong>pokemongo.sk</strong> a staňte sa číslom jedna na slovenskom trhu. Čistá, silná značka s obrovským organickým dosahom.
      </p>
      <div class="pt-2">
        <a
          href="/#ponuka"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl font-bold text-sm text-white bg-slate-900 hover:bg-slate-800 transition shadow-sm"
        >
          Predložiť ponuku na kúpu domény →
        </a>
      </div>
    </div>

  </section>

  <Footer slot="footer" />
</Layout>

<script>
  const searchInput = document.getElementById("store-search") as HTMLInputElement;
  const cards = document.querySelectorAll(".store-card") as NodeListOf<HTMLElement>;
  const counterText = document.getElementById("store-counter-text");
  const noResults = document.getElementById("no-store-results");
  const countryBtns = document.querySelectorAll(".country-btn") as NodeListOf<HTMLButtonElement>;
  const resetBtn = document.getElementById("reset-stores-btn");
  const emptyResetBtn = document.getElementById("empty-store-reset-btn");

  let activeCountry = "ALL";
  let searchQuery = "";
  const totalCount = cards.length;

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const searchData = card.getAttribute("data-search") || "";
      const countryData = card.getAttribute("data-country") || "";

      const matchesSearch = !searchQuery || searchData.includes(searchQuery);
      const matchesCountry = activeCountry === "ALL" || countryData === activeCountry;

      if (matchesSearch && matchesCountry) {
        card.style.display = "flex";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    if (counterText) {
      counterText.textContent = `Zobrazuje sa ${visibleCount} z ${totalCount} obchodov`;
    }

    if (noResults) {
      noResults.classList.toggle("hidden", visibleCount > 0);
    }

    const isFiltered = activeCountry !== "ALL" || searchQuery !== "";
    if (resetBtn) {
      resetBtn.classList.toggle("hidden", !isFiltered);
    }
  }

  function resetAll() {
    activeCountry = "ALL";
    searchQuery = "";
    if (searchInput) searchInput.value = "";

    countryBtns.forEach((btn) => {
      const isDefault = btn.getAttribute("data-country") === "ALL";
      btn.className = `country-btn px-5 py-2.5 rounded-2xl text-sm font-bold transition-all border ${
        isDefault
          ? "bg-slate-900 text-white border-slate-900 shadow-sm"
          : "bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100 hover:text-slate-900"
      }`;
    });

    applyFilters();
  }

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });
  }

  countryBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCountry = btn.getAttribute("data-country") || "ALL";

      countryBtns.forEach((b) => {
        const isSelected = b === btn;
        b.className = `country-btn px-5 py-2.5 rounded-2xl text-sm font-bold transition-all border ${
          isSelected
            ? "bg-slate-900 text-white border-slate-900 shadow-sm"
            : "bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100 hover:text-slate-900"
        }`;
      });

      applyFilters();
    });
  });

  if (resetBtn) resetBtn.addEventListener("click", resetAll);
  if (emptyResetBtn) emptyResetBtn.addEventListener("click", resetAll);
</script>
