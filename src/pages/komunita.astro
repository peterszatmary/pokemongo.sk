---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Domov",
        "item": "https://pokemongo.sk/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Komunita",
        "item": "https://pokemongo.sk/komunita/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Slovenská Pokémon GO Komunita: Skupiny, Raidy a Zrazy",
    "description": "Prehľad komunity Pokémon GO na Slovensku, raidové lokality v Bratislave, Košiciach a ďalších mestách.",
    "url": "https://pokemongo.sk/komunita/",
    "inLanguage": "sk-SK"
  }
];
---

<Layout
  title="Slovenská Pokémon GO Komunita: Raidy, Discord a Zrazy | pokemongo.sk"
  description="Prehľad slovenskej komunity Pokémon GO. Kde sa stretávajú tréneri v Bratislave, Košiciach a ďalších mestách, raidové hotspoty a komunitné skupiny."
  jsonLd={structuredData}
>
  <Navbar slot="navbar" />

  <article class="py-16 sm:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mb-14 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200 mb-4">
        👥 Tréneri & Lokálne Stretnutia
      </div>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
        Slovenská Pokémon GO Komunita
      </h1>
      <p class="text-base sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Kde sa na Slovensku hrajú najväčšie Raidy, ktoré parky sú plné PokéStopov a ako nájsť spoluhráčov vo vašom meste.
      </p>
    </header>

    <!-- Content Sections -->
    <div class="space-y-8 text-slate-600 leading-relaxed text-base">

      <!-- Cities & Hotspots -->
      <section class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-sm">
        <h2 class="font-display text-2xl font-bold text-slate-900 mb-6">Tradičné raidové hotspoty na Slovensku</h2>
        
        <div class="space-y-6">
          <div class="border-l-2 border-rose-500 pl-4">
            <h3 class="text-lg font-bold text-slate-900">Bratislava</h3>
            <p class="text-sm text-slate-600 mt-1 leading-relaxed">
              Najaktívnejšie lokality sú <strong>Sad Janka Kráľa</strong> (obrovská hustota PokéStopov a hniezd), <strong>Eurovea a nábrežie Dunaja</strong>, ako aj <strong>Medická záhrada a Prezidentská záhrada</strong>. Počas Community Days tu stretnete stovky hráčov s powerbankami v rukách.
            </p>
          </div>

          <div class="border-l-2 border-amber-500 pl-4">
            <h3 class="text-lg font-bold text-slate-900">Košice</h3>
            <p class="text-sm text-slate-600 mt-1 leading-relaxed">
              Srdcom košickej komunity je <strong>Hlavná ulica a Dóm sv. Alžbety</strong> spolu s <strong>Mestským parkom</strong>. Vďaka koncentrácii gymov je tu organizovanie Raid Hours mimoriadne efektívne.
            </p>
          </div>

          <div class="border-l-2 border-sky-500 pl-4">
            <h3 class="text-lg font-bold text-slate-900">Ostatné mestá (Žilina, Trnava, Nitra, Banská Bystrica)</h3>
            <p class="text-sm text-slate-600 mt-1 leading-relaxed">
              Vo väčšine krajských a okresných miest sa hráči združujú okolo historických centier a zámockých parkov, kde býva najväčší počet pamätihodností a gymov.
            </p>
          </div>
        </div>
      </section>

      <!-- Communication Platforms -->
      <section class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-sm">
        <h2 class="font-display text-2xl font-bold text-slate-900 mb-4">Ako a kde sa hráči organizujú?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80">
            <div class="text-slate-900 font-bold mb-1">Campfire (Niantic)</div>
            <p class="text-xs text-slate-600 leading-relaxed">Oficiálna mapa a chat od tvorcov hry. Umožňuje vidieť aktívne raidy v meste a pripojiť sa k lokálnym skupinám.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80">
            <div class="text-slate-900 font-bold mb-1">Discord Servery</div>
            <p class="text-xs text-slate-600 leading-relaxed">Prehľadne členené kanály podľa miest na výmenu Friend kódov, koordináciu raidov a PvP turnaje.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80">
            <div class="text-slate-900 font-bold mb-1">Facebook & Telegram</div>
            <p class="text-xs text-slate-600 leading-relaxed">Klasické skupiny fungujúce od roku 2016 na zdieľanie noviniek, screenshotov a organizáciu zrazov.</p>
          </div>
        </div>
      </section>

      <!-- Community Portal Potential -->
      <section class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-sm">
        <h2 class="font-display text-2xl font-bold text-slate-900 mb-3">Prečo Slovensku chýba jednotný portál?</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Väčšina komunikácie je dnes roztrúsená v desiatkach uzatvorených chatov a skupín. Doména <strong>pokemongo.sk</strong> má jedinečný potenciál stať sa <strong>centrálnym slovenským portálom</strong> — miestom, kde noví hráči nájdu sprievodcu, zberatelia burzu kartičiek a aktívni hráči mapu plánovaných podujatí a raidov.
        </p>
      </section>

    </div>

    <!-- CTA Box -->
    <div class="mt-16 p-8 rounded-3xl bg-slate-50 border border-slate-200/90 text-center space-y-4">
      <h3 class="font-display text-2xl font-bold text-slate-900">Chcete zjednotiť slovenskú Pokémon komunitu?</h3>
      <p class="text-sm text-slate-600 max-w-xl mx-auto">
        Získajte túto ikonickú doménu a vytvorte na nej oficiálny komunitný hub.
      </p>
      <div class="pt-2">
        <a
          href="/#ponuka"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm text-white bg-slate-900 hover:bg-slate-800 transition shadow-sm"
        >
          Predložiť ponuku na doménu →
        </a>
      </div>
    </div>
  </article>

  <Footer slot="footer" />
</Layout>
