---
interface Props {
  accessKey?: string;
}

const { accessKey = "970db82a-59c2-4846-85ff-e4a3beb761e5" } = Astro.props;
---

<div class="relative bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-xl">
  <!-- Decorative corner Pokéball accent -->
  <div class="absolute -top-5 -right-5 w-16 h-16 opacity-30 pointer-events-none hidden sm:block">
    <img src="/favicon.svg" alt="" class="w-full h-full rotate-12" />
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-poke-yellow/10 text-poke-yellow border border-poke-yellow/20 mb-3">
      <span class="w-2 h-2 rounded-full bg-poke-yellow animate-pulse"></span>
      Nezáväzný dopyt & ponuka
    </div>
    <h3 class="font-display text-2xl sm:text-3xl font-bold text-white mb-2">
      Máte záujem o kúpu domény?
    </h3>
    <p class="text-slate-400 text-sm sm:text-base">
      Vyplňte krátky formulár so svojou cenovou ponukou. Každú serióznu ponuku posúdime a odpovieme vám do 24 hodín.
    </p>
  </div>

  <form id="domain-offer-form" class="space-y-5">
    <!-- Web3Forms Access Key -->
    <input type="hidden" name="access_key" value={accessKey} id="web3forms_key" />
    <input type="hidden" name="subject" value="Nová cenová ponuka na doménu pokemongo.sk" />
    <input type="hidden" name="from_name" value="Pokemongo.sk Offer Bot" />
    <!-- Honeypot for spam protection -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Name -->
      <div>
        <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
          Vaše Meno / Spoločnosť <span class="text-poke-red">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="napr. Ján Novák / PokéShop s.r.o."
          class="w-full px-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-poke-yellow focus:ring-1 focus:ring-poke-yellow transition text-sm"
        />
      </div>

      <!-- Email -->
      <div>
        <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
          Váš E-mail <span class="text-poke-red">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="jan.novak@priklad.sk"
          class="w-full px-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-poke-yellow focus:ring-1 focus:ring-poke-yellow transition text-sm"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Phone -->
      <div>
        <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
          Telefónne číslo <span class="text-slate-500">(voliteľné)</span>
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="+421 900 123 456"
          class="w-full px-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-poke-yellow focus:ring-1 focus:ring-poke-yellow transition text-sm"
        />
      </div>

      <!-- Offer Amount -->
      <div>
        <label for="offer" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
          Navrhovaná cena (€) <span class="text-poke-red">*</span>
        </label>
        <input
          type="text"
          id="offer"
          name="offer"
          required
          placeholder="napr. 1 500 € (alebo 'Dohodou')"
          class="w-full px-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-poke-yellow focus:ring-1 focus:ring-poke-yellow transition text-sm font-semibold"
        />
      </div>
    </div>

    <!-- Purpose / Intent -->
    <div>
      <label for="purpose" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
        Plánované využitie domény
      </label>
      <select
        id="purpose"
        name="purpose"
        class="w-full px-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-poke-yellow focus:ring-1 focus:ring-poke-yellow transition text-sm"
      >
        <option value="eshop">E-shop (Pokémon kartičky, zberateľstvo, merch)</option>
        <option value="portal">Komunitný portál alebo sprievodca hrou</option>
        <option value="brand">Firemný brand / herné štúdio</option>
        <option value="investicia">Doménové portfólio / investícia</option>
        <option value="ine">Iné využitie</option>
      </select>
    </div>

    <!-- Message -->
    <div>
      <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
        Poznámka alebo správa <span class="text-slate-500">(voliteľné)</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="3"
        placeholder="Napíšte nám ďalšie podrobnosti, preferovaný spôsob platby, alebo akékoľvek otázky k prevodu..."
        class="w-full px-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-poke-yellow focus:ring-1 focus:ring-poke-yellow transition text-sm resize-y"
      ></textarea>
    </div>

    <!-- Submit Button & Feedback -->
    <div class="pt-2">
      <button
        type="submit"
        id="submit-button"
        class="w-full py-4 px-6 rounded-xl font-bold text-base text-slate-950 bg-gradient-to-r from-poke-yellow via-amber-400 to-poke-yellow hover:from-amber-300 hover:to-amber-400 shadow-xl shadow-amber-500/20 hover:shadow-amber-500/30 transition-all hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-3"
      >
        <img src="/favicon.svg" alt="" class="w-5 h-5" />
        <span>Odoslať nezáväznú cenovú ponuku</span>
      </button>
    </div>

    <!-- Security Note -->
    <div class="flex items-center justify-center gap-2 text-xs text-slate-300 pt-2 text-center">
      <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span>Vaše údaje sú v bezpečí a nebudú poskytnuté tretím stranám.</span>
    </div>

    <!-- Status Alerts -->
    <div id="form-result" class="hidden mt-4 p-4 rounded-xl text-sm font-medium text-center"></div>
  </form>
</div>

<script>
  const form = document.getElementById("domain-offer-form") as HTMLFormElement;
  const result = document.getElementById("form-result");
  const submitBtn = document.getElementById("submit-button") as HTMLButtonElement;

  if (form && result && submitBtn) {
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      
      const keyInput = document.getElementById("web3forms_key") as HTMLInputElement;
      if (keyInput && keyInput.value === "YOUR_WEB3FORMS_ACCESS_KEY_HERE") {
        // Helpful dev guidance if key is not configured yet
        result.className = "mt-4 p-4 rounded-xl text-sm font-medium text-center bg-amber-500/20 text-amber-300 border border-amber-500/40";
        result.innerHTML = `
          <strong>Web3Forms kľúč ešte nie je nastavený.</strong><br/>
          Pre aktiváciu stačí zadať bezplatný prístupový kľúč z <a href="https://web3forms.com" target="_blank" class="underline font-bold">web3forms.com</a> do kódu formulára.
        `;
        result.classList.remove("hidden");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-70", "cursor-not-allowed");
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = `
        <svg class="animate-spin h-5 w-5 text-slate-950 inline mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        Odosielam...
      `;

      const formData = new FormData(form);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (response.status === 200) {
          result.className = "mt-4 p-4 rounded-xl text-sm font-medium text-center bg-emerald-500/20 text-emerald-300 border border-emerald-500/40";
          result.innerHTML = "🎉 <strong>Ďakujeme!</strong> Vaša cenová ponuka bola úspešne doručená. Odpovieme vám čo najskôr na zadaný e-mail.";
          form.reset();
        } else {
          result.className = "mt-4 p-4 rounded-xl text-sm font-medium text-center bg-red-500/20 text-red-300 border border-red-500/40";
          result.innerHTML = `⚠️ Chyba: ${data.message || "Nepodarilo sa odoslať správu. Skúste to znova neskôr."}`;
        }
      } catch (error) {
        result.className = "mt-4 p-4 rounded-xl text-sm font-medium text-center bg-red-500/20 text-red-300 border border-red-500/40";
        result.innerHTML = "⚠️ Nastala neočakávaná chyba pri odosielaní. Skontrolujte svoje internetové pripojenie.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-70", "cursor-not-allowed");
        submitBtn.innerHTML = originalText;
        result.classList.remove("hidden");
      }
    });
  }
</script>
