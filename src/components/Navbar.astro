---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Predaj domény" },
  { href: "/sprievodca", label: "Sprievodca hrou" },
  { href: "/tcg-karty", label: "TCG Kartičky" },
  { href: "/komunita", label: "Komunita" },
  { href: "/ako-kupit", label: "Ako kúpiť" },
];
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-slate-950/80 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative w-10 h-10 transition-transform duration-300 group-hover:rotate-180">
          <img src="/favicon.svg" alt="Pokéball" class="w-full h-full drop-shadow-md" />
        </div>
        <div class="flex flex-col">
          <span class="font-display font-bold text-xl tracking-tight text-white group-hover:text-poke-yellow transition-colors">
            pokemongo<span class="text-poke-red">.sk</span>
          </span>
          <span class="text-[10px] tracking-widest uppercase font-semibold text-slate-400">
            Prémiová doména na predaj
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
                  isActive
                    ? "bg-slate-800 text-poke-yellow border border-slate-700 shadow-sm"
                    : "text-slate-300 hover:text-white hover:bg-slate-800/60"
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- CTA Button -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/#ponuka"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm text-slate-950 bg-gradient-to-r from-poke-yellow to-amber-400 hover:from-amber-300 hover:to-poke-yellow shadow-lg shadow-amber-500/20 hover:shadow-amber-500/30 transition-all hover:scale-105 active:scale-95"
        >
          <span>Poslať ponuku</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none"
        aria-label="Otvoriť menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-slate-950/95 px-4 pt-2 pb-6 space-y-2">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800"
        >
          {item.label}
        </a>
      ))
    }
    <div class="pt-3">
      <a
        href="/#ponuka"
        class="flex items-center justify-center gap-2 w-full py-3 rounded-xl font-semibold text-sm text-slate-950 bg-gradient-to-r from-poke-yellow to-amber-400 shadow-md"
      >
        Poslať ponuku na doménu
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const hamburger = document.getElementById("hamburger-icon");
  const close = document.getElementById("close-icon");

  if (btn && menu && hamburger && close) {
    btn.addEventListener("click", () => {
      const isExpanded = menu.classList.toggle("hidden");
      hamburger.classList.toggle("hidden", !isExpanded);
      close.classList.toggle("hidden", isExpanded);
    });
  }
</script>
